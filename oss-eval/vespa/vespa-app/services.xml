<services version="1.0">
  <container id="default" version="1.0">
    <document-api />
    <search />
    <http>
      <server id="default" port="8080" />
    </http>
  </container>

    <content id="music" version="1.0">
    <redundancy>1</redundancy>  
    <engine>
        <proton />
    </engine>
    <documents>
        <document type="music" mode="index" />
    </documents>
    <nodes>
        <node hostalias="default" distribution-key="0" />
    </nodes>
    </content>

  <admin version="2.0">
    <adminserver hostalias="default" />
  </admin>
</services>
